# =============================================================================
# SUPABASE
# =============================================================================
# Get these from: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# =============================================================================
# DATABASE
# =============================================================================
# Get these from: Supabase Dashboard → Settings → Database → Connection string
# Transaction mode (for app - use connection pooler, port 6543)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Session mode (for migrations - direct connection, port 5432)
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# =============================================================================
# AUTH
# =============================================================================
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-32-char-secret-here
NEXTAUTH_URL=http://localhost:3000

# =============================================================================
# TELEGRAM (Optional - for notifications)
# =============================================================================
# Create bot with @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:ABC-DEF...
TELEGRAM_CHAT_ID=123456789

# =============================================================================
# EMAIL (Optional - for reports)
# =============================================================================
# Get from: resend.com dashboard
RESEND_API_KEY=re_...
EMAIL_FROM=Finance <finance@rcconsultech.com>

# =============================================================================
# APP
# =============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
